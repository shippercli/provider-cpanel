{
  "name": "cPanel",
  "slug": "cpanel",
  "logo": "logo.svg",
  "status": "beta",
  "statusNote": "Currently in early testing. Some features may not work as expected on all cPanel accounts or hosting configurations.",
  "description": "Deploy and operate applications on cPanel accounts with API access.",
  "features": [
    "Static and PHP Deployments",
    "Git Version Control",
    "Domain Management",
    "DNS Record Management",
    "Database Management",
    "Email Accounts and Forwarders",
    "Scoped FTP Accounts",
    "PHP and Composer",
    "Passenger Applications",
    "Environment Variables",
    "Cron Jobs",
    "Redirects",
    "SSL Certificates",
    "Release Backups and Rollback",
    "Deployment Status",
    "Error Logs",
    "Safe Cleanup"
  ],
  "config": {
    "provider": "cpanel",
    "host": "cpanel.example.com",
    "port": 2083,
    "username": "myuser",
    "api_token": "${CPANEL_API_TOKEN}",
    "deployment_method": "auto"
  },
  "install": "composer require shippercli/provider-cpanel"
}
